# Nakili kuwa ".env" na ujaze. Usiweke .env kwenye GitHub.
# Maoni yawe kwenye mistari yake; thamani ziandikwe bila nafasi/maoni mwishoni.
GROQ_API_KEY=
OPENAI_API_KEY=

# Server
PORT=8787
# HOST: tumia 0.0.0.0 tu ukiweka ACCESS_TOKEN
HOST=127.0.0.1
# ACCESS_TOKEN hiari: ukiweka, UI itaomba token kabla ya kutranscribe
ACCESS_TOKEN=
# ALLOW_CLIENT_KEYS=false inamaanisha keys zitumike kutoka server pekee
ALLOW_CLIENT_KEYS=true
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MIN=10

# Models (badilisha OpenAI model bila kugusa code)
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_STT_MODEL=whisper-1
